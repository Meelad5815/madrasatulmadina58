rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function madrasaId() { return signedIn() ? request.auth.token.madrasaId : null; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isQari() { return signedIn() && role() == 'qari'; }
    function isParent() { return signedIn() && role() == 'parent'; }
    function sameMadrasa(data) { return signedIn() && data.madrasaId == madrasaId(); }
    function assignmentId(studentId) { return request.auth.uid + '_' + studentId; }
    function assignedToQari(studentId) {
      let assignmentPath = /databases/$(database)/documents/student_assignments/$(assignmentId(studentId));
      return exists(assignmentPath)
        && get(assignmentPath).data.qariUid == request.auth.uid
        && get(assignmentPath).data.status == 'active';
    }
    function parentLinked(studentId) {
      let linkPath = /databases/$(database)/documents/student_parent_links/$(assignmentId(studentId));
      return exists(linkPath)
        && get(linkPath).data.verified == true
        && get(linkPath).data.parentUid == request.auth.uid;
    }

    match /public_content/{docId} {
      allow read: if resource.data.status == 'published' && resource.data.visibility == 'public';
      allow create, update: if isAdmin() && sameMadrasa(request.resource.data);
      allow delete: if isAdmin() && sameMadrasa(resource.data);
    }

    match /announcements/{docId} {
      allow read: if (resource.data.status == 'published' && resource.data.audience == 'public')
        || (isAdmin() && sameMadrasa(resource.data))
        || (signedIn() && sameMadrasa(resource.data) && resource.data.audience in ['parents', 'staff']);
      allow create, update: if isAdmin() && sameMadrasa(request.resource.data);
      allow delete: if isAdmin() && sameMadrasa(resource.data);
    }

    // Keep only the minimum necessary, non-sensitive profile fields in students.
    // Put guardian contacts, DOB, address and other sensitive data in student_private.
    match /students/{studentId} {
      allow read: if (isAdmin() && sameMadrasa(resource.data))
        || (isQari() && sameMadrasa(resource.data) && assignedToQari(studentId))
        || (isParent() && sameMadrasa(resource.data) && parentLinked(studentId));
      allow write: if false;
    }

    match /student_private/{studentId} {
      allow read: if isAdmin() && sameMadrasa(resource.data);
      allow write: if false;
    }

    match /teachers/{teacherId} {
      allow read: if (isAdmin() && sameMadrasa(resource.data))
        || (signedIn() && sameMadrasa(resource.data) && request.auth.uid == teacherId);
      allow write: if false;
    }

    match /student_assignments/{assignmentId} {
      allow read: if (isAdmin() && sameMadrasa(resource.data))
        || (signedIn() && sameMadrasa(resource.data) && resource.data.qariUid == request.auth.uid)
        || (isParent() && sameMadrasa(resource.data) && parentLinked(resource.data.studentId));
      allow write: if false;
    }

    match /student_parent_links/{linkId} {
      allow read: if (isAdmin() && sameMadrasa(resource.data))
        || (signedIn() && sameMadrasa(resource.data) && resource.data.parentUid == request.auth.uid);
      allow write: if false;
    }

    match /attendance/{recordId} {
      allow read: if (isAdmin() && sameMadrasa(resource.data))
        || (isQari() && sameMadrasa(resource.data) && assignedToQari(resource.data.studentId))
        || (isParent() && sameMadrasa(resource.data) && parentLinked(resource.data.studentId));
      allow write: if false;
    }

    match /progress_logs/{recordId} {
      allow read: if (isAdmin() && sameMadrasa(resource.data))
        || (isQari() && sameMadrasa(resource.data) && assignedToQari(resource.data.studentId))
        || (isParent() && sameMadrasa(resource.data)
          && resource.data.parentVisible == true && parentLinked(resource.data.studentId));
      allow write: if false;
    }

    match /certificates/{certificateId} {
      allow read: if (isAdmin() && sameMadrasa(resource.data))
        || (isParent() && sameMadrasa(resource.data)
          && resource.data.parentVisible == true && parentLinked(resource.data.studentId));
      allow create, update: if isAdmin() && sameMadrasa(request.resource.data);
      allow delete: if isAdmin() && sameMadrasa(resource.data);
    }

    // Audit records are written only by trusted server-side functions.
    match /audit_logs/{logId} {
      allow read: if isAdmin() && sameMadrasa(resource.data);
      allow write: if false;
    }

    // Role claims are issued by a trusted administrative process, never by the client.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}