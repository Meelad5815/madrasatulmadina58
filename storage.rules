rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
    function sameMadrasa() {
      return signedIn() && request.auth.token.madrasaId == 'mrk-madrasa-58';
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && sameMadrasa()
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /private/students/{studentId}/{fileName} {
      allow read, write: if isAdmin() && sameMadrasa();
      allow create, update: if isAdmin() && sameMadrasa()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
    }

    match /private/certificates/{studentId}/{fileName} {
      allow read, write: if isAdmin() && sameMadrasa();
      allow create, update: if isAdmin() && sameMadrasa()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('(image/(jpeg|png|webp)|application/pdf)');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}